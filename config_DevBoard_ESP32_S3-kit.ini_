[env:esp32-s3-kit]
board = esp32-s3-devkitm-1

build_type = debug  ;более подробная отладка

;Полезные команды PlatformIO:
;bash (терминал)
;pio run --target clean   # сбросить кеш
;pio run                  # пересобрать

;pio run -t upload        # Загрузка кода
;pio run -t uploadfs      # Загрузка файлов в SPIFFS
;pio run -t monitor       # Монитор порта

platform = espressif32@6.5.0   ; или новее, если доступна
;board = esp32-s3-devkitm-1
board_upload.maximum_size = 1966080
;board_upload.flash_size = 4MB
;размер флеш памяти
board_upload.flash_size = 16MB

board_build.flash_mode = qio
board_build.bootloader = dio
;board_build.partitions = min_spiffs.csv
board_build.partitions = default_16MB.csv

# Активация поддержки PSRAM
board_build.arduino.memory_type = qio_opi
board_build.psram_type = opi

build_flags =
    ${common.build_flags}
;        -Wall
;        -Wextra
        ;-Wdouble-promotion             ; double to float warnings
        -W implicit-fallthrough         ; switch case without break
;        -DAUDIO_LOG
         -D BOARD_HAS_PSRAM
    ;    -D BOARD_HAS_NO_PSRAM
        -D ENV_ESP32_S3_KIT             ;анализируем дальше (\src\core\options.h) какой файл с пинами (/myoptions.h) использовать


        ;Полезные команды PlatformIO:
;bash (терминал)
;pio run --target clean   # сбросить кеш
;pio run                  # пересобрать

;pio run -t upload        # Загрузка кода
;pio run -t uploadfs      # Загрузка файлов в SPIFFS
;pio run -t monitor       # Монитор порта